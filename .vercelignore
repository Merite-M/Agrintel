# Python pipeline runs on your computer or GitHub Actions, not on Vercel
pipeline/
nisr-agro-early-warning/pipeline/

# Database migrations are applied to Neon, not deployed
drizzle/
nisr-agro-early-warning/drizzle/

# Reference CSV data (do not ignore TypeScript modules in src/lib/data)
/data/
/nisr-agro-early-warning/data/
!/nisr-agro-early-warning/src/lib/data/**
!nisr-agro-early-warning/src/lib/data/**
!/src/lib/data/**
!src/lib/data/**
!**/src/lib/data/**

# Documentation and secrets stay out of the deployment
*.md
.env*
