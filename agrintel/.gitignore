# Dependencies and build output
node_modules/
.next/
out/
build/
*.tsbuildinfo
next-env.d.ts

# Secrets: never commit real credentials
.env
.env.local
.env*.local

# OS and editor files
.DS_Store
Thumbs.db
.vscode/

# Python virtual environment & cache
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Large raw data: link these in the README instead of committing them
data/raw/*.zip
data/raw/*.xlsx
data/raw/*.parquet

# Raw third-party downloads stay out of the repository (see README, "Data links")
data/raw/
